{
  "dockerComposeFile": "../docker-compose.yml",
  "service": "hashiqube",
  "workspaceFolder": "/vagrant",
  "forwardPorts": [
    "localhost:8001"
  ],
  "portsAttributes": {
    "8001": {
      "protocol": "https"
    }
  },
  "remoteEnv": {
    "BASH_ENV": "/etc/profile.d/vexport.sh",
    "VAULT_ADDR": "http://127.0.0.1:8200"
  },
  "postCreateCommand": {
    "install-mcp-servers-and-vexport": "bash /vagrant/.devcontainer/install-tools.sh"
  },
  "postStartCommand": {
    "set-git-config-safe-directory": "git config --global --add safe.directory ${containerWorkspaceFolder}",
    "set-git-config-line-endings": "git config --global core.autocrlf input",
    "set-git-config-gpg-program": "git config --global --add gpg.program /usr/bin/gpg",
    "print-message-of-the-day": "echo \"bash /etc/update-motd.d/00-header\" >> ~/.bashrc",
    "service-swapspace-start": "service swapspace start"
  },
  "postAttachCommand": {
    "print-message-of-the-day": "bash /etc/update-motd.d/00-header"
  },
  "customizations": {
    "vscode": {
      "settings": {
        "editor.fontSize": 16,
        "terminal.integrated.fontSize": 16,
        "terminal.integrated.scrollback": 1000,
        "[markdown]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode",
          "editor.tabSize": 2
        },
        "editor.formatOnSave": true,
        "evenBetterToml.formatter.allowedBlankLines": 2,
        "files.exclude": {
          "*.egg-info": true,
          ".pytest_cache": true,
          ".tox": true,
          "__pycache__": true,
          "build": true
        },
        "git.ignoreLimitWarning": true,
        "sortLines.filterBlankLines": true,
        "yaml.completion": true,
        "yaml.customTags": [
          "!encrypted/pkcs1-oaep scalar",
          "!vault scalar"
        ],
        "yaml.format.enable": false,
        "yaml.validate": true,
        "evenBetterToml.formatter.alignComments": false,
        "[yaml]": {
          "editor.defaultFormatter": "redhat.vscode-yaml"
        },
        "[terraform]": {
          "editor.formatOnSave": true,
          "editor.defaultFormatter": "hashicorp.terraform",
          "editor.tabSize": 2,
          "experimentalFeatures.validateOnSave": true
        },
        "[terraform-vars]": {
          "editor.tabSize": 2
        },
        "terminal.integrated.defaultProfile.linux": "bash",
        "workbench.colorCustomizations": {
          "activityBar.activeBackground": "#00cc8f",
          "activityBar.activeBorder": "#370960",
          "activityBar.background": "#00FFB3",
          "activityBar.foreground": "#370960",
          "activityBar.inactiveForeground": "#37096099",
          "activityBarBadge.background": "#370960",
          "activityBarBadge.foreground": "#ffffff",
          "activityBarTop.activeBackground": "#00cc8f",
          "activityBarTop.activeBorder": "#370960",
          "activityBarTop.background": "#00FFB3",
          "activityBarTop.foreground": "#370960",
          "activityBarTop.inactiveForeground": "#37096099",
          "commandCenter.activeBorder": "#5cdeff",
          "commandCenter.border": "#5cdeff80",
          "commandCenter.foreground": "#ffffff",
          "focusBorder": "#ea216b",
          "panelTitle.activeBorder": "#ea216b",
          "progressBar.background": "#5cdeff",
          "sash.hoverBorder": "#5cdeff",
          "statusBar.background": "#ea216b",
          "statusBar.debuggingBackground": "#ff5800",
          "statusBar.debuggingForeground": "#ffffff",
          "statusBar.foreground": "#ffffff",
          "statusBar.inactiveBackground": "#ea216b99",
          "statusBarItem.hoverBackground": "#c4185a",
          "statusBarItem.remoteBackground": "#5cdeff",
          "statusBarItem.remoteForeground": "#370960",
          "statusBarItem.remoteHoverBackground": "#61e190",
          "statusBarItem.remoteHoverForeground": "#370960",
          "tab.activeBorderTop": "#ea216b",
          "titleBar.activeBackground": "#370960",
          "titleBar.activeForeground": "#ffffff",
          "titleBar.border": "#5cdeff",
          "titleBar.inactiveBackground": "#37096099",
          "titleBar.inactiveForeground": "#ffffff99"
        }
      },
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "hashicorp.terraform",
        "nhoizey.gremlins",
        "hashicorp.hcl",
        "redhat.vscode-yaml",
        "hashicorp.sentinel",
        "hashicorp.vault-radar",
        "owenfarrell.vscode-vault",
        "anthropic.claude-code",
        "openai.chatgpt",
        "johnpapa.vscode-peacock"
      ],
      "mcp": {
        "servers": {
          "vault-mcp-server": {
            "type": "stdio",
            "command": "bash",
            "args": [
              "/vagrant/.devcontainer/vault-mcp-server.sh"
            ]
          },
          "terraform-mcp-server": {
            "type": "stdio",
            "command": "terraform-mcp-server",
            "args": [
              "stdio"
            ]
          }
        }
      }
    }
  }
}
